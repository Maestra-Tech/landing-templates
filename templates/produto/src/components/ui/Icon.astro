---
import type { SocialIconName } from '@/site.config'

/**
 * Ícones genéricos, desenhados em traço simples. Nenhum deles é logotipo de marca: são desenhos
 * de "câmera", "conversa", "vídeo" etc., para você apontar para a rede que quiser.
 *
 * Os quatro últimos (`shape-*`) são os símbolos de enfeite usados na faixa de logos de exemplo.
 */
interface Props {
  name: SocialIconName | 'shape-1' | 'shape-2' | 'shape-3' | 'shape-4'
  class?: string
}

const { name, class: className } = Astro.props

const PATHS: Record<Props['name'], string[]> = {
  camera: [
    'M4 8.5h3l1.4-2.2h7.2L17 8.5h3a1 1 0 0 1 1 1v8.2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5a1 1 0 0 1 1-1z',
    'M12 16.4a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z',
  ],
  chat: [
    'M4.5 5h15a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H11l-4.6 3.4V17H4.5A1.5 1.5 0 0 1 3 15.5v-9A1.5 1.5 0 0 1 4.5 5z',
    'M8 10h8M8 13h5',
  ],
  play: ['M4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11A1.5 1.5 0 0 1 4.5 5z', 'M10 9.2v5.6l4.8-2.8z'],
  users: [
    'M9 11.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z',
    'M3 19.2c.5-3 2.9-4.8 6-4.8s5.5 1.8 6 4.8',
    'M16 11a2.8 2.8 0 1 0-.9-5.4M17 14.6c2.2.4 3.6 2 4 4.6',
  ],
  briefcase: ['M4 8h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z', 'M9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2', 'M3 13h18'],
  mail: ['M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z', 'M3.5 7.5l8.5 6 8.5-6'],
  phone: ['M8 3h8a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 16 21H8a1.5 1.5 0 0 1-1.5-1.5v-15A1.5 1.5 0 0 1 8 3z', 'M11 18h2'],
  globe: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', 'M3 12h18', 'M12 3c2.6 2.6 3.8 5.6 3.8 9S14.6 18.4 12 21c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z'],
  'shape-1': ['M12 3l9 9-9 9-9-9z'],
  'shape-2': ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', 'M12 7.5v9M7.5 12h9'],
  'shape-3': ['M4 18L12 4l8 14z'],
  'shape-4': ['M5 5h14v14H5z', 'M5 12h14'],
}
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
