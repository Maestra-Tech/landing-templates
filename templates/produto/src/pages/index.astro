---
import Base from '@/layouts/Base.astro'
import BeforeAfter from '@/components/sections/BeforeAfter.astro'
import Compare from '@/components/sections/Compare.astro'
import Demo from '@/components/sections/Demo.astro'
import Faq from '@/components/sections/Faq.astro'
import Features from '@/components/sections/Features.astro'
import FinalCta from '@/components/sections/FinalCta.astro'
import Footer from '@/components/sections/Footer.astro'
import Hero from '@/components/sections/Hero.astro'
import Inside from '@/components/sections/Inside.astro'
import Logos from '@/components/sections/Logos.astro'
import Nav from '@/components/sections/Nav.astro'
import Pricing from '@/components/sections/Pricing.astro'
import Problem from '@/components/sections/Problem.astro'
import Showcase from '@/components/sections/Showcase.astro'
import Steps from '@/components/sections/Steps.astro'
import Testimonials from '@/components/sections/Testimonials.astro'

/**
 * A página. A ordem das linhas abaixo é a ordem das seções na tela: para mudar a ordem, mude as
 * linhas de lugar. Para esconder uma seção, não apague daqui: desligue em `src/site.config.ts`.
 */
---

<Base>
  <a href="#conteudo" class="sr-only skip-link">Ir para o conteúdo</a>

  <Nav />

  <main id="conteudo" class="surface-shell">
    <div class="grain-layer" aria-hidden="true"></div>
    <div class="spotlight-layer" aria-hidden="true"></div>

    <Hero />
    <Logos />
    <Problem />
    <Compare />
    <Demo />
    <Features />
    <Steps />
    <Inside />
    <BeforeAfter />
    <Showcase />
    <Testimonials />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>

  <Footer />
</Base>
