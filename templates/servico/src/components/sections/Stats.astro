---
// NÚMEROS — três cards com brilho colorido atrás, número grande em
// gradiente e fonte citada. Um card pode ter barras de comparação.
// Só aparece com "enabled: true" e pelo menos um item no config.
import { site } from '../../site.config';
import SectionHead from '../ui/SectionHead.astro';
import { rich } from '../../lib/rich';

const stats = site.stats;
const show = stats.enabled && stats.items.length > 0;
const hasClosing = stats.closing || stats.bridge || stats.sources;
---

{
  show && (
    <section class="section stats" id="numeros">
      <SectionHead eyebrow={stats.eyebrow} title={stats.title} titleAccent={stats.titleAccent} titleAfter={stats.titleAfter} text={stats.text} />

      <div class="stats__bento">
        {stats.items.map((item, index) => (
          <div class="stat" style={`--stat-grad: var(--grad-${['cta', 'a', 'b'][index % 3]})`}>
            {/* O brilho fica numa camada própria; quem aparece ao rolar é a
                camada de dentro, para o desfoque não ser cortado. */}
            <div class="stat__glow" aria-hidden="true">
              <div class="stat__glow-paint" data-reveal={(index * 0.1).toFixed(1)} />
            </div>
            <div class="stat__surface" data-reveal={(index * 0.1).toFixed(1)}>
              <div class="grain-layer" aria-hidden="true" />
              <p class="stat__figure">
                {item.prefix && <span class="stat__prefix">{item.prefix}</span>}
                <span class="stat__value">{item.value}</span>
              </p>
              <div class="stat__info">
                <p class="stat__label">{item.label}</p>
                {item.bars && item.bars.length > 0 && (
                  <div class="stat__bars">
                    {item.bars.map((bar) => (
                      <div class:list={['bar', { 'bar--hl': bar.highlight }]}>
                        <span class="bar__label">{bar.label}</span>
                        <span class="bar__track"><span class="bar__fill" style={`width: ${Math.max(0, Math.min(100, bar.percent))}%`} /></span>
                        <span class="bar__value">{bar.percent}</span>
                      </div>
                    ))}
                  </div>
                )}
                {item.source &&
                  (item.sourceUrl ? (
                    <a class="stat__source" href={item.sourceUrl} target="_blank" rel="noopener">{item.source}</a>
                  ) : (
                    <span class="stat__source">{item.source}</span>
                  ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      {hasClosing && (
        <div class="closing stats__closing" data-reveal>
          {stats.closing && <p class="closing__text rich" data-wordreveal set:html={rich(stats.closing)} />}
          {stats.bridge && (
            <p class="bridge">
              {stats.bridge} {stats.bridgeAccent && <span class="serif">{stats.bridgeAccent}</span>}
            </p>
          )}
          {stats.sources && <span class="mono-note">{stats.sources}</span>}
        </div>
      )}
    </section>
  )
}

<style>
  .stats {
    padding-top: clamp(52px, 9vh, 124px);
  }

  /* Grade "bento": uma coluna no celular; no computador, o primeiro card é
     um pouco mais largo. */
  .stats__bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 28px);
  }

  @media (min-width: 1024px) {
    .stats__bento {
      grid-template-columns: 1.15fr 1fr 1fr;
    }
  }

  .stat {
    position: relative;
  }

  /* Brilho colorido atrás do card (efeito "cardGlow"). */
  .stat__glow {
    display: none;
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    filter: blur(45px);
    opacity: 0.5;
    transition: opacity 260ms var(--ease-out);
  }

  :global(.fx-glow) .stat__glow {
    display: block;
  }

  .stat:first-child .stat__glow {
    opacity: 0.55;
  }

  .stat__glow-paint {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    background: var(--stat-grad);
  }

  .stat__surface {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    height: 100%;
    padding: clamp(24px, 2.5vw, 36px);
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    color: var(--ink);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .stat__surface > :not(.grain-layer) {
    position: relative;
    z-index: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .stat__surface:hover {
      border-color: var(--line-strong);
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 6%, transparent);
    }
  }

  .stat__figure {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .stat__prefix {
    font-size: clamp(22px, 1.8vw, 26px);
    font-weight: 500;
    color: color-mix(in srgb, var(--ink) 90%, transparent);
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(54px, 5.6vw, 92px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--accent-2);
  }

  .stat:first-child .stat__value {
    font-size: clamp(62px, 6.6vw, 112px);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .stat__value {
      background-image: var(--stat-grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .stat__info {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .stat__label {
    max-width: 420px;
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 90%, transparent);
  }

  .stat:first-child .stat__label {
    font-size: clamp(17px, 1.5vw, 20px);
  }

  .stat__source {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
  }

  a.stat__source {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Barras de comparação ---- */
  .stat__bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 2px;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
  }

  .bar--hl {
    color: color-mix(in srgb, var(--ink) 90%, transparent);
  }

  .bar__label {
    flex: none;
    width: 52px;
    letter-spacing: 0.1em;
  }

  .bar__track {
    flex: 1;
    height: 6px;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .bar__fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .bar--hl .bar__fill {
    background: var(--stat-grad);
  }

  .stats__closing {
    max-width: 820px;
  }
</style>
