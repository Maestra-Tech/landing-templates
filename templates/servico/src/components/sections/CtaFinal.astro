---
// CHAMADA FINAL — manchas de cor desfocadas ao fundo, título grande, o
// "manifesto" que acende palavra por palavra e o botão principal.
import { site } from '../../site.config';
import CtaButton from '../ui/CtaButton.astro';
import { rich } from '../../lib/rich';

const cta = site.finalCta;
---

<section class="final" id="contato">
  <div class="final__orb final__orb--1" aria-hidden="true"></div>
  <div class="final__orb final__orb--2" aria-hidden="true"></div>
  <div class="final__orb final__orb--3" aria-hidden="true"></div>
  <div class="grain-layer" aria-hidden="true"></div>

  <div class="final__inner">
    {cta.eyebrow && <span class="eyebrow" data-reveal>{cta.eyebrow}</span>}
    <h2 class="final__title" data-reveal>
      {cta.title}{cta.titleAccent && <>{' '}<span class="accent">{cta.titleAccent}</span></>}{cta.titleAfter && ` ${cta.titleAfter}`}
    </h2>
    {cta.text && <p class="final__text" data-reveal="0.1">{cta.text}</p>}
    {cta.manifesto && <p class="final__manifesto rich" data-wordreveal set:html={rich(cta.manifesto)} />}
    <div class="final__actions">
      <CtaButton label={cta.ctaLabel} quiet />
      {cta.ctaNote && <p class="fine-print">{cta.ctaNote}</p>}
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
  }

  /* Manchas de cor desfocadas. */
  .final__orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .final__orb--1 {
    top: -20%;
    left: -10%;
    width: 55%;
    height: 70%;
    background: var(--grad-cta);
    filter: blur(110px);
    opacity: 0.22;
  }

  .final__orb--2 {
    bottom: -25%;
    right: -10%;
    width: 55%;
    height: 75%;
    background: var(--grad-b);
    filter: blur(110px);
    opacity: 0.2;
  }

  .final__orb--3 {
    top: 10%;
    right: 20%;
    width: 35%;
    height: 45%;
    background: var(--grad-a);
    filter: blur(100px);
    opacity: 0.14;
  }

  .final__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 3vh, 32px);
    max-width: 1080px;
    margin-inline: auto;
    padding: clamp(60px, 10vh, 160px) var(--gutter);
    text-align: center;
  }

  .final__title {
    font-size: clamp(38px, 5.8vw, 84px);
    line-height: 1.03;
    letter-spacing: -0.03em;
  }

  .final__text {
    max-width: 820px;
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.55;
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }

  .final__manifesto {
    max-width: 900px;
    font-size: clamp(19px, 2vw, 25px);
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }

  .final__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }
</style>
