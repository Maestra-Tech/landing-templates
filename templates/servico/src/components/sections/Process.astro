---
// COMO FUNCIONA (BASTIDORES) — faixa de fundo mais escuro. À esquerda, a
// lista de princípios separados por linhas finas. À direita (coluna que
// acompanha a rolagem): um diagrama, uma "ficha" em letra de máquina e uma
// frase forte. Os dois primeiros cards têm parallax.
import { site } from '../../site.config';
import SectionHead from '../ui/SectionHead.astro';
import MockFlow from '../mocks/MockFlow.astro';
import Mock from '../mocks/Mock.astro';

const proc = site.process;
const show = proc.enabled && proc.items.length > 0;
const hasStatement = proc.statement.accent || proc.statement.text;
const hasAside = proc.diagram || proc.sheet || hasStatement;
---

{
  show && (
    <section class="process" id="como-funciona">
      <div class="section process__inner">
        <SectionHead eyebrow={proc.eyebrow} title={proc.title} titleAccent={proc.titleAccent} titleAfter={proc.titleAfter} text={proc.text} accent="a" />

        <div class="process__grid">
          <div class="process__list">
            {proc.items.map((item, index) => (
              <div class="process__item" data-reveal={(index * 0.05).toFixed(2)}>
                <span class="process__label">{item.label}</span>
                <h3 class="process__title">{item.title}</h3>
                <p class="process__text">{item.text}</p>
              </div>
            ))}
          </div>

          {hasAside && (
            <div class="process__aside">
              {proc.diagram && (
                <div data-plx="0.03">
                  <div class="card process__card process__card--diagram" data-reveal="0.1">
                    {proc.diagram.kind === 'flow' ? <MockFlow {...proc.diagram} /> : <Mock mock={proc.diagram} wide />}
                  </div>
                </div>
              )}
              {proc.sheet && (
                <div data-plx="0.06">
                  <div class="card process__card process__card--sheet" data-reveal="0.2">
                    <span class="process__card-label">{proc.sheet.label}</span>
                    <pre class="sheet" tabindex="0"><code>{proc.sheet.lines.map((line, index) => (
                      <span class="sheet__line"><span class="sheet__num" aria-hidden="true">{index + 1}</span>{line.comment ? <span class="sheet__comment">{`// ${line.comment}`}</span> : <><span class="sheet__keyword">{line.keyword}</span>{line.text ? ` ${line.text}` : ''}</>}{'\n'}</span>
                    ))}</code></pre>
                  </div>
                </div>
              )}
              {hasStatement && (
                <div class="card process__card" data-reveal="0.25">
                  <p class="process__statement">
                    {proc.statement.accent && <span class="serif">{proc.statement.accent}</span>} {proc.statement.text}
                  </p>
                </div>
              )}
            </div>
          )}
        </div>

        {proc.bridge && (
          <p class="bridge" data-wordreveal>
            {proc.bridge} {proc.bridgeAccent && <span class="serif" data-k>{proc.bridgeAccent}</span>}
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  /* Faixa de largura total, com fundo próprio e linhas em cima e embaixo. */
  .process {
    position: relative;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-raised);
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: start;
    gap: clamp(28px, 4vw, 64px);
  }

  .process__list {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .process__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(20px, 2.5vh, 28px) 0;
    border-top: 1px solid var(--line);
  }

  .process__item:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .process__label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  .process__title {
    font-size: clamp(19px, 1.7vw, 22px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .process__text {
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.65;
    color: color-mix(in srgb, var(--ink) 90%, transparent);
  }

  /* Coluna da direita: acompanha a rolagem no computador. */
  .process__aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .process__aside {
      position: sticky;
      top: 100px;
    }
  }

  .process__card {
    padding: clamp(20px, 2.2vw, 28px);
    overflow-wrap: anywhere;
  }

  .process__card--diagram {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .process__card--sheet {
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: auto;
  }

  .process__card-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
  }

  /* "Ficha" em letra de máquina, com números de linha. */
  .sheet {
    margin: 0;
    max-width: 100%;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14.5px;
    line-height: 1.7;
    white-space: pre;
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }

  .sheet__num {
    display: inline-block;
    width: 2ch;
    color: color-mix(in srgb, var(--ink) 40%, transparent);
    user-select: none;
  }

  .sheet__comment {
    color: color-mix(in srgb, var(--ink) 70%, transparent);
  }

  .sheet__keyword {
    color: var(--accent-2);
  }

  .process__statement {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.65;
    color: color-mix(in srgb, var(--ink) 85%, transparent);
  }

  .process__statement .serif {
    font-family: var(--font-decorative);
    font-style: italic;
    font-size: 1.25em;
    color: var(--ink);
  }
</style>
